FROM python:3.12-alpine3.24@sha256:4c47124a8391cb7a9f571164147d154777cf012a4ece5f86097130d7a4478111 AS xml-build

WORKDIR /opt/xml-build
RUN apk add --no-cache build-base pkgconf libxslt-dev
ADD --checksum=sha256:98087fd181d9070724f3fbc65c7377db03038eb92bd882374daff44940138821 \
    https://download.gnome.org/sources/libxml2/2.15/libxml2-2.15.4.tar.xz /tmp/libxml2.tar.xz
RUN mkdir /tmp/libxml2 && tar -xf /tmp/libxml2.tar.xz -C /tmp/libxml2 --strip-components=1 \
    && cd /tmp/libxml2 \
    && ./configure --prefix=/usr/local --without-python --without-readline \
    && make -j2 \
    && make install
ADD --checksum=sha256:9acfe68419c4d06a45c550321b3212762d92f41465062ca4ea19e632ee5d216e \
    https://download.gnome.org/sources/libxslt/1.1/libxslt-1.1.45.tar.xz /tmp/libxslt.tar.xz
RUN mkdir /tmp/libxslt && tar -xf /tmp/libxslt.tar.xz -C /tmp/libxslt --strip-components=1 \
    && cd /tmp/libxslt \
    && XML2_CONFIG=/usr/local/bin/xml2-config ./configure --prefix=/usr/local --without-python \
    && make -j2 \
    && make install
ADD --checksum=sha256:45222d94ddd511536f3b2f7d9deae3b2339b4ce0f075f1ca25703b07cad9dd21 \
    https://files.pythonhosted.org/packages/23/ad/28ecd7cb894d172f3c9c80a075eeeb2017ac62e3632cee05a5f9493547eb/lxml-6.1.3.tar.gz /tmp/lxml.tar.gz
RUN pip install --no-cache-dir setuptools==80.9.0 wheel==0.45.1 \
    && mkdir /opt/wheels \
    && XML2_CONFIG=/usr/local/bin/xml2-config XSLT_CONFIG=/usr/local/bin/xslt-config \
        CFLAGS=-I/usr/local/include/libxml2 \
        LDFLAGS='-L/usr/local/lib -Wl,-rpath,/usr/local/lib' \
        pip wheel --no-deps --no-build-isolation /tmp/lxml.tar.gz -w /opt/wheels

FROM python:3.12-alpine3.24@sha256:4c47124a8391cb7a9f571164147d154777cf012a4ece5f86097130d7a4478111

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/opt/project-watch/src \
    LD_LIBRARY_PATH=/usr/local/lib

WORKDIR /opt/project-watch
RUN apk add --no-cache \
    pcre2=10.49-r0 \
    poppler-utils=25.12.0-r1 \
    tesseract-ocr=5.5.2-r0 \
    tesseract-ocr-data-chi_sim=5.5.2-r0 \
    tesseract-ocr-data-eng=5.5.2-r0
COPY requirements-parser.lock ./
COPY --from=xml-build /usr/local/lib/libxml2.so* /usr/local/lib/
COPY --from=xml-build /usr/local/lib/libxslt.so* /usr/local/lib/
COPY --from=xml-build /usr/local/lib/libexslt.so* /usr/local/lib/
COPY --from=xml-build /opt/wheels/lxml-*.whl /tmp/
RUN pip install --no-cache-dir --only-binary=:all: --require-hashes -r requirements-parser.lock \
    && pip install --no-index --force-reinstall --no-deps /tmp/lxml-*.whl \
    && rm /tmp/lxml-*.whl \
    && python -c 'from lxml import etree; assert etree.LIBXML_VERSION == (2, 15, 4); assert etree.LIBXSLT_VERSION == (1, 1, 45)'
COPY src/ ./src/

USER 65534:65534
ENTRYPOINT ["python", "-m", "project_watch.extraction_process"]
