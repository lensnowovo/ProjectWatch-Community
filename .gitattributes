* text=auto
*.py text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.html text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.command text eol=lf
# Lock inputs are canonical LF. Byte-pinned upstream notices are stored without
# text conversion so Git blobs/source ZIPs and checkouts retain identical bytes.
packaging/dsh/*.json text eol=lf
packaging/dsh/upstream-licenses/*.txt -text
